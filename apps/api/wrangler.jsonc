{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuegol-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "DEMO_MODE": "true",
    "SERVICE_ORIGIN": "https://fuegol-api.manhattan.workers.dev",
    "USER_AGENT": "fuegolbot/0.1 (+https://fuegol.ink/bot)",
    "SEARCH_PROVIDER": "exa"
  },

  "ai": { "binding": "AI" },

  "durable_objects": {
    "bindings": [
      { "name": "CRAWL", "class_name": "CrawlCoordinator" },
      { "name": "EXTRACT", "class_name": "ExtractCoordinator" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CrawlCoordinator"] },
    { "tag": "v2", "new_sqlite_classes": ["ExtractCoordinator"] }
  ]

  // --- Optional bindings (uncomment + provision to enable higher tiers) ---
  //
  // Browser Rendering (JS-rendered scrape, screenshots, AI /json extraction):
  //   "browser": { "binding": "BROWSER" }
  //
  // Workers AI (AI extraction / summary):
  //   "ai": { "binding": "AI" }
  //
  // D1 (API keys, credit ledger, job metadata) — see migrations/:
  //   "d1_databases": [{ "binding": "DB", "database_name": "fuegol", "database_id": "<uuid>" }]
  //
  // R2 (crawl artifacts, screenshots, result bundles):
  //   "r2_buckets": [{ "binding": "ARTIFACTS", "bucket_name": "fuegol-artifacts" }]
  //
  // Queues (async batch orchestration):
  //   "queues": { "producers": [{ "binding": "CRAWL_QUEUE", "queue": "fuegol-crawl" }] }
}
