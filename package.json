{
  "name": "fuegol.ink",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "fuegol.ink — the web data engine for AI. Firecrawl-compatible. Cloudflare-powered. Half the price.",
  "homepage": "https://fuegol.ink",
  "repository": {
    "type": "git",
    "url": "https://github.com/heymegabyte/fuegol.ink.git"
  },
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "dev": "pnpm --filter @fuegol/api dev",
    "deploy:api": "pnpm --filter @fuegol/api deploy",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "@cloudflare/workerd-darwin-arm64",
      "@cloudflare/workerd-darwin-64"
    ]
  }
}
